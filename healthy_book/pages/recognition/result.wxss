.result-container {
  padding: 20rpx;
  background-color: #f9f9f9;
  min-height: 100vh;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  margin-bottom: 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.empty-space {
  width: 60rpx;
  height: 60rpx;
}

/* 食物图片 */
.food-image-container {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.food-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 识别结果 */
.recognition-result {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.food-name-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.food-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.confidence {
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 5rpx 15rpx;
}

.confidence-text {
  font-size: 24rpx;
  color: #666;
}

.similar-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.similar-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.similar-item {
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #4A90E2;
}

/* 份量调整 */
.portion-adjustment {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.portion-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.portion-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
}

.minus {
  background-color: #f5f5f5;
  color: #666;
}

.plus {
  background-color: #4A90E2;
  color: #fff;
}

.portion-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin: 0 40rpx;
}

.portion-options {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.portion-option {
  width: 120rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
}

.portion-option.active {
  background-color: #4A90E2;
  color: #fff;
}

/* 营养信息 */
.nutrition-info {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.nutrition-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.nutrition-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10rpx;
}

.nutrition-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 5rpx;
}

.nutrition-label {
  font-size: 24rpx;
  color: #666;
}

/* 添加到记录按钮 */
.add-to-record-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5CB8E6 100%);
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 5rpx 15rpx rgba(74, 144, 226, 0.3);
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}