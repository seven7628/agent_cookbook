.camera-container {
  width: 100%;
  height: 100vh;
  position: relative;
  background-color: #000;
}

/* 相机预览区域 */
.camera-preview {
  width: 100%;
  height: 100%;
}

/* 拍摄指南 */
.guide-text {
  position: absolute;
  top: 80rpx;
  width: 100%;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

/* 拍摄框 */
.camera-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  height: 400rpx;
}

.frame-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 2rpx solid #4A90E2;
  border-radius: 16rpx;
  box-shadow: 0 0 0 2000rpx rgba(0,0,0,0.5);
}

.corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #4A90E2;
  border-style: solid;
}

.top-left {
  top: -2rpx;
  left: -2rpx;
  border-width: 6rpx 0 0 6rpx;
}

.top-right {
  top: -2rpx;
  right: -2rpx;
  border-width: 6rpx 6rpx 0 0;
}

.bottom-left {
  bottom: -2rpx;
  left: -2rpx;
  border-width: 0 0 6rpx 6rpx;
}

.bottom-right {
  bottom: -2rpx;
  right: -2rpx;
  border-width: 0 6rpx 6rpx 0;
}

/* 底部操作栏 */
.camera-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  background-color: rgba(0,0,0,0.7);
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.album-btn {
  width: 80rpx;
  height: 80rpx;
}

.album-icon {
  width: 100%;
  height: 100%;
}

.capture-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid #fff;
  background-color: transparent;
}

.cancel-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cancel-icon {
  width: 50rpx;
  height: 50rpx;
}

/* 照片预览区域 */
.preview-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000;
  z-index: 10;
}

.preview-image {
  width: 100%;
  height: calc(100% - 180rpx);
  object-fit: contain;
}

.preview-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: rgba(0,0,0,0.7);
}

.retake-btn {
  width: 160rpx;
  height: 80rpx;
  background-color: transparent;
  border: 2rpx solid #fff;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.confirm-btn {
  width: 160rpx;
  height: 80rpx;
  background-color: #4A90E2;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.retake-text,
.confirm-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}