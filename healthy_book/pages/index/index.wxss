.container {
  padding: 20rpx;
  background-color: #f9f9f9;
  min-height: 100vh;
}

/* 用户信息和热量进度 */
.user-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 15rpx;
}

.user-info {
  margin-bottom: 20rpx;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.date {
  font-size: 28rpx;
  color: #666;
}

.calorie-progress {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.progress-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

/* 拍照按钮 */
.camera-btn-container {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.camera-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90E2 0%, #5CB8E6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 5rpx 20rpx rgba(74, 144, 226, 0.3);
}

.camera-icon {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 10rpx;
}

.camera-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* 营养摄入比例 */
.nutrition-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
  display: block;
}

.nutrition-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chart {
  width: 300rpx;
  height: 300rpx;
}

.nutrition-legend {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.color-block {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.protein {
  background-color: #4A90E2;
}

.carb {
  background-color: #7ED321;
}

.fat {
  background-color: #F5A623;
}

.legend-text {
  font-size: 26rpx;
  color: #666;
}

/* 今日饮食记录 */
.record-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.meal-list {
  margin-top: 20rpx;
}

.meal-item {
  margin-bottom: 30rpx;
}

.meal-time {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
  padding-left: 10rpx;
  border-left: 6rpx solid #4A90E2;
}

.food-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.food-item {
  width: calc(50% - 10rpx);
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 15rpx;
  display: flex;
  align-items: center;
}

.food-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 5rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-nutrition {
  font-size: 22rpx;
  color: #666;
}