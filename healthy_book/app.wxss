/**app.wxss**/
/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  background-color: #f9f9f9;
  color: #333333;
}

/* 清除默认样式 */
/* * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
} */

/* 全局主题颜色 */
:root {
  --primary-color: #4A90E2;
  --primary-light: #5CB8E6;
  --primary-dark: #3A80D2;
  --secondary-color: #F5A623;
  --secondary-light: #FFB84D;
  --secondary-dark: #E09010;
  --success-color: #7ED321;
  --warning-color: #FFCC00;
  --danger-color: #FF4D4F;
  --gray-light: #f5f5f5;
  --gray: #e0e0e0;
  --gray-dark: #999999;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --white: #ffffff;
  --shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  --radius: 16rpx;
}

/* 通用样式类 */
.container {
  padding: 20rpx;
}

.card {
  background-color: var(--white);
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: var(--white);
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 5rpx 15rpx rgba(74, 144, 226, 0.3);
}

.btn-secondary {
  background-color: var(--gray-light);
  color: var(--text-secondary);
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 图标样式 */
.icon {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 文本溢出处理 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载中提示 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

/* 空状态提示 */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}